# ============================================
# منصة إدارة الدفعة — متغيرات البيئة
# انسخ هذا الملف إلى .env.local ثم عدّل القيم
# ⚠️ لا ترفع .env.local إلى Git أبداً (مستثنى في .gitignore)
# ============================================

# --- Supabase (مطلوب) ---
# القيم العامة — آمن ظهورها في المتصفح
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ⚠️ سري جداً — يُستخدم على السيرفر فقط، لا يُشحن للمتصفح أبداً
# احصل عليه من: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Cloudflare Workers (للنشر فقط، عبر wrangler secret) ---
# لا تضعها في هذا الملف للتوزيع — استخدم:
#   wrangler secret put SUPABASE_SERVICE_ROLE_KEY

# --- خادم MCP على Supabase Edge Function ---
# توكن للاختبار المباشر (اختياري — الأفضل استخدام api_keys من لوحة الأدمن)
# يُضبط عبر: supabase secrets set MCP_SECRET_TOKEN=...
# MCP_SECRET_TOKEN=

# حد معدل الطلبات لكل مفتاح API (طلبات/دقيقة) — افتراضي 120
# يُضبط عبر: supabase secrets set MCP_RATE_LIMIT_PER_MIN=120
# MCP_RATE_LIMIT_PER_MIN=120

# رابط صفحة موافقة OAuth (افتراضياً /oauth/authorize على تطبيقك)
# OAUTH_AUTHORIZE_URL=https://your-domain/oauth/authorize
