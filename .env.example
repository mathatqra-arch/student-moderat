# ==========================================
# Firebase Phone Auth (مجاني 100% — بدون كارت)
# يدعم 10 SMS/يوم في الـ Spark Plan المجاني
# ==========================================
# --- Client-side (تظهر للمتصفح) ---
# NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
# NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# --- Server-side (سري — للتحقق من idToken) ---
# خيار A (موصى به): الصق كل ملف JSON كنسخة نصية واحدة (سطر واحد)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com",...}
#
# خيار B: متغيرات منفصلة
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
