# ==========================================
# كاش طويل لأصول البناء المهرّشة — أسماء الملفات بيتغير مع كل build
# فالكاش immutable آمن 100% (زي ما Next.js بيعمل على Vercel)
# بتتحمل دي مباشرة من Cloudflare Static Assets وبتوفر 15+ ريكوست
# إعادة تحقق (304) في كل زيارة صفحة — من نتايج اختبار الحمل
# ==========================================

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
